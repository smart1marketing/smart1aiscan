# --- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Smart 1 Suite webhook ------------------------------------------------
# Where captured leads (plus their scan results) get POSTed as JSON.
# Get this URL from Smart 1 Suite's lead-intake / webhook settings.
SMART1_WEBHOOK_URL=https://your-smart1-suite-instance.example.com/webhooks/leads
# Optional bearer token if Smart 1 Suite's webhook requires auth.
SMART1_WEBHOOK_TOKEN=

# --- Misc ------------------------------------------------------------------
# Where the "Book My Strategy Call" button on the finished report sends people.
CALENDAR_URL=https://smart1marketing.com/book-a-call

# Render sets PORT automatically — no need to set this yourself on Render.
PORT=3000

# --- Insites (primary analysis engine) -------------------------------------
# API key from your Insites account settings. When set, scans run real
# Insites audits; when unset (or on any Insites failure), the app falls
# back to its built-in scanner automatically.
INSITES_API_KEY=
# Optional overrides
# INSITES_API_BASE=https://api.insites.com/api/v1
# INSITES_MAX_WAIT_MS=150000

# --- Conversion copy (all optional — sensible defaults if unset) -----------
CTA_LABEL=Get My Free Action Plan
TRUST_LINE=No obligation — just a clear picture of where you stand.
# Link a real finished report so prospects can see the format before opting in.
SAMPLE_REPORT_URL=

# --- Cloudinary (PDF report storage + raw audit data archive) --------------
# Every unlocked report gets rendered as a PDF and uploaded to Cloudinary,
# alongside the full raw Insites audit payload as JSON — both durably
# retrievable later, not just for the lifetime of the in-memory scan cache.
# Get these from your Cloudinary account: Dashboard -> API Keys.
# This app does NOT send email directly — it hands the PDF/data URLs to
# Smart 1 Suite via the webhook, and Smart 1 Suite's own automation sends
# the report email using those links.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: organizes uploads under this Cloudinary folder.
CLOUDINARY_FOLDER=smart1-ai-visibility-reports

# --- Insites credit budgeting -----------------------------------------------
# Reuse a stored scan of the same domain (from Cloudinary) instead of
# spending a fresh Insites credit, for up to this many days. Requires
# Cloudinary to be configured (that's where scans are stored). Default 30.
# Set to 0 to disable reuse and always run a fresh audit.
INSITES_CACHE_TTL_DAYS=30

# --- Troubleshooting panel --------------------------------------------------
# Set this to enable /debug.html — a live activity log, in-flight scan
# state, and a "run a test scan" tool, gated behind this token. If unset,
# the debug API routes return 404 (fully disabled, not just unauthorized).
# Pick a long random string — treat it like a password.
DEBUG_TOKEN=
